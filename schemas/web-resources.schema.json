{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Star List Web Resources",
  "type": "object",
  "required": [
    "schemaVersion",
    "resources"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "url",
          "aliases",
          "category",
          "domains",
          "topics",
          "bestFor",
          "avoidWhen",
          "accessModel",
          "usagePolicy",
          "licenseNote",
          "autoIntegrate"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 2
          },
          "url": {
            "type": "string",
            "pattern": "^https://[^ ]+$"
          },
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^https://[^ ]+$"
            }
          },
          "category": {
            "enum": [
              "prompt-library",
              "design-gallery",
              "motion-gallery",
              "component-registry",
              "library-documentation",
              "shader-playground",
              "ai-builder"
            ]
          },
          "domains": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "ai_agents",
                "ai_memory",
                "ai_media",
                "software_engineering",
                "web_frontend",
                "backend",
                "mobile",
                "graphics",
                "game_dev",
                "trading",
                "cybersecurity",
                "data_ml",
                "devops",
                "productivity",
                "other"
              ]
            }
          },
          "topics": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          },
          "bestFor": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 2
            }
          },
          "avoidWhen": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 2
            }
          },
          "accessModel": {
            "enum": [
              "free",
              "freemium",
              "paid",
              "unknown"
            ]
          },
          "usagePolicy": {
            "enum": [
              "reference-only",
              "review-license"
            ]
          },
          "licenseNote": {
            "type": "string",
            "minLength": 10
          },
          "autoIntegrate": {
            "type": "boolean",
            "const": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
