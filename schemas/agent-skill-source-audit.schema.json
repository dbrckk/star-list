{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pinned Skill Source Metadata Audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "checkedAt",
    "mode",
    "total",
    "coverageComplete",
    "counts",
    "findings",
    "sourceContentReviewed",
    "automaticInstallation",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "checkedAt": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "online",
        "offline"
      ]
    },
    "total": {
      "type": "integer",
      "minimum": 1
    },
    "coverageComplete": {
      "type": "boolean"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verified",
        "missing",
        "invalid",
        "unavailable",
        "unchecked"
      ],
      "properties": {
        "verified": {
          "type": "integer",
          "minimum": 0
        },
        "missing": {
          "type": "integer",
          "minimum": 0
        },
        "invalid": {
          "type": "integer",
          "minimum": 0
        },
        "unavailable": {
          "type": "integer",
          "minimum": 0
        },
        "unchecked": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "findings": {
      "type": "integer",
      "minimum": 0
    },
    "sourceContentReviewed": {
      "const": false
    },
    "automaticInstallation": {
      "const": false
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sourceRepository",
          "sourceCommit",
          "sourcePath",
          "sourceUrl",
          "status",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "sourceRepository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "sourceCommit": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "sourcePath": {
            "type": "string",
            "pattern": "^(?:[A-Za-z0-9_.-]+/)*SKILL[.]md$"
          },
          "sourceUrl": {
            "type": "string",
            "pattern": "^https://github[.]com/"
          },
          "status": {
            "enum": [
              "verified",
              "missing",
              "invalid",
              "unavailable",
              "unchecked"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
